{
  "name": "@captchafox/svelte",
  "version": "1.0.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "dev": "svelte-package -i src/lib -o dist --watch",
    "build": "svelte-package -i src/lib -o dist && tsup",
    "lint": "TIMING=1 eslint \"src/**/*.{ts,svelte}\"",
    "lint:types": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf coverage",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@captchafox/types": "^1.6.0"
  },
  "devDependencies": {
    "@captchafox/internal": "*",
    "@captchafox/tsconfig": "*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint-config-captchafox": "*",
    "eslint-plugin-svelte": "^2.46.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "svelte",
    "captchafox"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CaptchaFox/javascript-integrations.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/CaptchaFox/javascript-integrations/issues"
  },
  "homepage": "https://github.com/CaptchaFox/javascript-integrations#readme"
}
